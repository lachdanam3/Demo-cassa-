<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>B.V.S. - Scansione Ottica IA Offline</title>
    <!-- Caricamento delle librerie TensorFlow ufficiali -->
    <script src="https://jsdelivr.net"></script>
    <script src="https://jsdelivr.net"></script>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f4f6f9; margin: 0; padding: 15px; }
        .panel { background: white; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        h2 { color: #1e3c72; margin-top: 0; }
        .upload-box { background-color: #e3f2fd; border: 2px dashed #2196f3; padding: 15px; border-radius: 6px; margin-bottom: 15px; }
        .upload-row { margin: 8px 0; font-size: 13px; font-weight: bold; }
        #webcam-container { width: 100%; height: 320px; background-color: #000; border-radius: 6px; overflow: hidden; display: flex; justify-content: center; align-items: center; border: 3px solid #ddd; }
        #start-btn { display: none; width: 100%; padding: 12px; background-color: #ff9800; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 16px; margin-top: 10px; }
        .detected-banner { display: none; background-color: #e8f5e9; border: 2px solid #4caf50; color: #2e7d32; padding: 15px; border-radius: 6px; margin-top: 15px; text-align: center; font-size: 18px; font-weight: bold; }
        .action-btn { width: 100%; padding: 12px; background-color: #2e7d32; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 10px; font-size: 15px; }
        .prediction-row { display: flex; align-items: center; margin: 6px 0; font-size: 11px; }
        .progress-bar { flex: 1; background: #eee; height: 10px; margin: 0 10px; border-radius: 5px; overflow: hidden; }
        .progress-fill { background: #2a5298; height: 100%; width: 0%; }
    </style>
</head>
<body>

<div class="panel">
    <h2>1. Bordin Vision System - Scanner Offline</h2>
    
    <!-- Box di caricamento manuale dei 3 file di Teachable Machine -->
    <div class="upload-box" id="upload-container">
        <h4 style="margin: 0 0 10px 0; color: #0d47a1;">Carica i file del modello per attivare l'IA:</h4>
        <div class="upload-row">1. File Model (.json): <input type="file" id="model-upload" accept=".json"></div>
        <div class="upload-row">2. File Weights (.bin): <input type="file" id="weights-upload" accept=".bin"></div>
        <div class="upload-row">3. File Metadata (.json): <input type="file" id="metadata-upload" accept=".json"></div>
    </div>

    <button id="start-btn" onclick="init()">ATTIVA TELECAMERA IA</button>
    
    <div id="webcam-container">
        <div style="color: #666; text-align: center;">In attesa dei file del modello...</div>
    </div>

    <div id="detected-banner" class="detected-banner">
        Rilevato: <span id="detected-name">-</span>
        <button class="action-btn" onclick="inviaAggiunta()">INVIA DATI ALLA CASSA AI</button>
    </div>

    <h3 style="margin-top:20px; font-size: 14px; color: #555;">Elaborazione Rete Neurale:</h3>
    <div id="label-container"></div>
</div>
<script>
    let model, webcam, labelContainer, maxLabels;
    let currentMatch = "";
    let isLocked = false;

    // Controlla quando tutti e 3 i file sono stati inseriti per mostrare il tasto di avvio
    const mUp = document.getElementById('model-upload');
    const wUp = document.getElementById('weights-upload');
    const metaUp = document.getElementById('metadata-upload');

    function checkFiles() {
        if (mUp.files.length > 0 && wUp.files.length > 0 && metaUp.files.length > 0) {
            document.getElementById('start-btn').style.display = 'block';
            document.getElementById('webcam-container').innerHTML = "<div style='color:#4caf50; font-weight:bold;'>File pronti! Clicca il pulsante arancione per avviare la webcam.</div>";
        }
    }
    mUp.addEventListener('change', checkFiles);
    wUp.addEventListener('change', checkFiles);
    metaUp.addEventListener('change', checkFiles);

    async function init() {
        document.getElementById('start-btn').style.display = 'none';
        document.getElementById('upload-container').style.display = 'none';
        const container = document.getElementById('webcam-container');
        container.innerHTML = "<div style='color:#ff9800; font-weight:bold;'>Inizializzazione Rete Neurale Locale...</div>";

        try {
            // CORREZIONE: Passiamo il singolo file [0] richiesto dall'algoritmo
            model = await tmImage.loadFromFiles(mUp.files[0], wUp.files[0], metaUp.files[0]);
            maxLabels = model.getTotalClasses();
            
            // Configurazione della telecamera
            webcam = new tmImage.Webcam(400, 320, true);
            await webcam.setup();
            await webcam.play();
            window.requestAnimationFrame(loop);

            container.innerHTML = "";
            container.appendChild(webcam.canvas);
            
            labelContainer = document.getElementById("label-container");
            labelContainer.innerHTML = "";
            for (let i = 0; i < maxLabels; i++) {
                let r = document.createElement("div");
                r.className = "prediction-row";
                r.innerHTML = `<span></span><div class="progress-bar"><div class="progress-fill"></div></div><span>0%</span>`;
                labelContainer.appendChild(r);
            }
        } catch (e) {
            console.error(e);
            container.innerHTML = "<div style='color:red; padding:10px;'>Errore hardware video o permessi negati dal browser. Assicurati che Chrome abbia l'accesso alla webcam attivo per i file locali.</div>";
        }
    }

    async function loop() {
        webcam.update();
        await predict();
        window.requestAnimationFrame(loop);
    }

    async function predict() {
        if (isLocked) return;
        const prediction = await model.predict(webcam.canvas);
        let highestProb = 0;
        let bestMatch = "";

        for (let i = 0; i < maxLabels; i++) {
            const name = prediction[i].className;
            const prob = prediction[i].probability;
            const row = labelContainer.childNodes[i];
            
            if(row) {
                row.childNodes[0].innerText = name;
                row.childNodes[1].childNodes[0].style.width = (prob * 100) + "%";
                row.childNodes[2].innerText = Math.round(prob * 100) + "%";
            }

            if (prob > highestProb) {
                highestProb = prob;
                bestMatch = name;
            }
        }

        if (highestProb > 0.80) {
            currentMatch = bestMatch;
            document.getElementById("detected-name").innerText = bestMatch + " (" + Math.round(highestProb * 100) + "%)";
            document.getElementById("detected-banner").style.display = "block";
        } else {
            document.getElementById("detected-banner").style.display = "none";
        }
    }

    function inviaAggiunta() {
        if (!currentMatch) return;
        localStorage.setItem('bvs_prodotto_rilevato', currentMatch);
        isLocked = true;
        document.getElementById("detected-banner").style.backgroundColor = "#ffebee";
        document.getElementById("detected-banner").style.borderColor = "#f44336";
        document.getElementById("detected-name").innerText = "INVIATO IN CASSA...";
        
        setTimeout(() => {
            isLocked = false;
            document.getElementById("detected-banner").style.backgroundColor = "#e8f5e9";
            document.getElementById("detected-banner").style.borderColor = "#4caf50";
        }, 3000);
    }
</script>

